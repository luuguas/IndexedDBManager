{
  "name": "@luuguas/idbmanager",
  "version": "2.0.0-beta.3",
  "description": "A Promise wrapper for simple IndexedDB operations",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "jsdelivr": "./dist/umd.js",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "prepack": "yarn build",
    "build": "yarn tsdown",
    "lint": "yarn eslint",
    "lint-fix": "yarn eslint --fix",
    "test": "yarn vitest run --coverage",
    "test-watch": "yarn vitest watch"
  },
  "author": "luuguas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luuguas/IndexedDBManager.git"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^30",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
