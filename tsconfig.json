{
  "compilerOptions": {
    "target": "es2025",
    "module": "esnext", // for front-end ("commonjs" for back-end)
    "lib": ["es2025", "dom"],
    "rootDir": "./src",
    "outDir": "./dist",

    "moduleResolution": "bundler",
    "types": ["node"], // @types are no longer auto-discovered (Typescript 6.0+)
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "coverage"]
}
